build --symlink_prefix=".bazel/bazel-"

# Use protoc from toolchains_protoc to avoid building from source
build --incompatible_enable_proto_toolchain_resolution

# Treat warnings in our Rust code as errors. Third-party crates are built with
# capped lints, so this only affects code in this repository.
build --@rules_rust//rust/settings:extra_rustc_flag=-Dwarnings
