load("@rules_cc//cc:defs.bzl", "cc_library")

# The headers jemalloc's configure generates, configured as
# tikv-jemalloc-sys configures it: symbols prefixed `_rjem_`, statistics,
# and background threads on where the platform supports them.
HEADERS = [
    "include/jemalloc/internal/jemalloc_internal_defs.h",
    "include/jemalloc/internal/jemalloc_preamble.h",
    "include/jemalloc/internal/public_namespace.h",
    "include/jemalloc/internal/public_unnamespace.h",
    "include/jemalloc/jemalloc.h",
    "include/jemalloc/jemalloc_defs.h",
    "include/jemalloc/jemalloc_macros.h",
    "include/jemalloc/jemalloc_mangle.h",
    "include/jemalloc/jemalloc_mangle_jet.h",
    "include/jemalloc/jemalloc_protos.h",
    "include/jemalloc/jemalloc_protos_jet.h",
    "include/jemalloc/jemalloc_rename.h",
    "include/jemalloc/jemalloc_typedefs.h",
]

# Generated for x86_64 Linux against the pinned sysroot.
cc_library(
    name = "config_linux_x86_64",
    hdrs = ["linux_x86_64/" + header for header in HEADERS],
    strip_include_prefix = "linux_x86_64/include",
)

# Generated for arm64 macOS, with the zone allocator off so that, as on
# Linux, jemalloc serves only Rust's allocations. macOS has no background
# threads.
cc_library(
    name = "config_macos_aarch64",
    hdrs = ["macos_aarch64/" + header for header in HEADERS],
    strip_include_prefix = "macos_aarch64/include",
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "config",
    actual = select(
        {
            ":linux_x86_64": ":config_linux_x86_64",
            ":macos_aarch64": ":config_macos_aarch64",
        },
        no_match_error = "jemalloc is configured only for x86_64 Linux and arm64 macOS",
    ),
    visibility = ["@jemalloc//:__pkg__"],
)
