load("@rules_cc//cc:defs.bzl", "cc_library")

# jemalloc as configure and make would build it, with the configured
# headers for the target from //third_party/jemalloc. Library-private symbols
# aren't renamed, as make's private_namespace.h step would; they have hidden
# visibility.
cc_library(
    name = "jemalloc",
    srcs = [
        "src/jemalloc.c",
        "src/arena.c",
        "src/background_thread.c",
        "src/base.c",
        "src/bin.c",
        "src/bin_info.c",
        "src/bitmap.c",
        "src/buf_writer.c",
        "src/cache_bin.c",
        "src/ckh.c",
        "src/counter.c",
        "src/ctl.c",
        "src/decay.c",
        "src/div.c",
        "src/ecache.c",
        "src/edata.c",
        "src/edata_cache.c",
        "src/ehooks.c",
        "src/emap.c",
        "src/eset.c",
        "src/exp_grow.c",
        "src/extent.c",
        "src/extent_dss.c",
        "src/extent_mmap.c",
        "src/fxp.c",
        "src/san.c",
        "src/san_bump.c",
        "src/hook.c",
        "src/hpa.c",
        "src/hpa_hooks.c",
        "src/hpdata.c",
        "src/inspect.c",
        "src/large.c",
        "src/log.c",
        "src/malloc_io.c",
        "src/mutex.c",
        "src/nstime.c",
        "src/pa.c",
        "src/pa_extra.c",
        "src/pai.c",
        "src/pac.c",
        "src/pages.c",
        "src/peak_event.c",
        "src/prof.c",
        "src/prof_data.c",
        "src/prof_log.c",
        "src/prof_recent.c",
        "src/prof_stats.c",
        "src/prof_sys.c",
        "src/psset.c",
        "src/rtree.c",
        "src/safety_check.c",
        "src/sc.c",
        "src/sec.c",
        "src/stats.c",
        "src/sz.c",
        "src/tcache.c",
        "src/test_hooks.c",
        "src/thread_event.c",
        "src/ticker.c",
        "src/tsd.c",
        "src/witness.c",
    ] + glob(["include/jemalloc/internal/*.h"]),
    copts = [
        "-std=gnu11",
        "-O3",
        "-funroll-loops",
        "-fvisibility=hidden",
        "-D_GNU_SOURCE",
        "-D_REENTRANT",
        "-DJEMALLOC_NO_PRIVATE_NAMESPACE",
        "-Wno-error",
        "-w",
    ],
    includes = ["include"],
    linkopts = [
        "-lm",
        "-lpthread",
        "-ldl",
    ],
    visibility = ["//visibility:public"],
    deps = ["@@//third_party/jemalloc:config"],
)
