"""Hermetic C/C++ toolchain, used by rules_rust for linking.

Avoids depending on whatever compiler (if any) is installed on the host.
"""

bazel_dep(name = "toolchains_llvm", version = "1.11.2")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

llvm.toolchain(
    llvm_version = "20.1.4",
)

# Link against a pinned Debian sysroot rather than the host's libc and libgcc,
# so builds don't depend on which -dev packages the host has installed. This is
# Chromium's published sysroot; the hash is from Chromium's
# build/linux/sysroot_scripts/sysroots.json.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sysroot_linux_x86_64",
    build_file = "//third_party/llvm:sysroot.BUILD.bazel",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e"],
    type = "tar.xz",
)

llvm.sysroot(
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)

use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")
