"""Rust crates from crates.io, resolved by crate_universe."""

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.spec(
    package = "clap",
    version = "4.5",
    features = ["derive"],
)

crate.spec(
    package = "bytes",
    version = "1.7",
)

crate.spec(
    package = "tracing",
    version = "0.1",
)

crate.spec(
    package = "tracing-subscriber",
    version = "0.3",
    features = ["env-filter"],
)

crate.spec(
    package = "thiserror",
    version = "2",
)

crate.spec(
    package = "tempfile",
    version = "3",
)

crate.spec(
    package = "libc",
    version = "0.2",
)

crate.spec(
    package = "ring",
    version = "0.17",
)

crate.spec(
    package = "async-trait",
    version = "0.1",
)

crate.spec(
    package = "serde",
    version = "1.0",
    features = ["derive"],
)

crate.spec(
    package = "toml",
    version = "0.8",
)

crate.spec(
    package = "data-encoding",
    version = "2.8",
)

# Reading container image layers, which are tar files, often gzipped.
crate.spec(
    package = "tar",
    version = "0.4",
)

crate.spec(
    package = "flate2",
    version = "1",
)

# Async runtime and RPC dependencies

crate.spec(
    package = "tokio",
    version = "1",
    features = ["full"],
)

crate.spec(
    package = "tokio-stream",
    version = "0.1",
    features = ["full"],
)

# Connect RPC: generated message types, service traits, servers and clients.
# The server speaks gRPC, which Bazel uses, as well as the Connect protocol.
# zstd is left out of the default features because it builds C from source.
crate.spec(
    default_features = False,
    features = [
        "client",
        "gzip",
        "json",
        "server",
    ],
    package = "connectrpc",
    version = "0.9.1",
)

crate.spec(
    features = ["json"],
    package = "buffa",
    version = "0.9.2",
)

# The well-known types (google.protobuf.*), which generated code refers to.
crate.spec(
    features = ["json"],
    package = "buffa-types",
    version = "0.9.2",
)

# preserve_order keeps JSON objects in their given order, as Starlark's
# json.decode must.
crate.spec(
    features = ["preserve_order"],
    package = "serde_json",
    version = "1",
)

# Streams for streaming RPCs, which connectrpc types as futures' Stream.
crate.spec(
    package = "futures",
    version = "0.3",
)

# Uri, which connectrpc's clients are configured with.
crate.spec(
    package = "http",
    version = "1",
)

# The //bazel/connect codegen driver.
crate.spec(
    package = "anyhow",
    version = "1",
)

crate.spec(
    package = "buffa-codegen",
    version = "0.9.2",
)

crate.spec(
    package = "connectrpc-codegen",
    version = "0.9.0",
)

# The engine behind bb's Bazel-compatible commands: compressing stored values,
# fast hashing of interned ids, and the Starlark language.
crate.spec(
    package = "lz4_flex",
    version = "0.11",
)

# Deriving skycodec's Encode and Decode.
crate.spec(
    package = "proc-macro2",
    version = "1",
)

crate.spec(
    package = "quote",
    version = "1",
)

crate.spec(
    package = "syn",
    version = "2",
    features = ["full"],
)

crate.spec(
    package = "hashbrown",
    version = "0.16",
)

# Compressing stored values with dictionaries trained on values of the same
# kind, which small values need to compress well.
crate.spec(
    package = "zstd",
    version = "0.13",
    features = ["experimental"],
)

crate.spec(
    package = "rustc-hash",
    version = "2",
)

# For paging frozen heaps out, the version pagable uses.
crate.spec(
    package = "dashmap",
    version = "6",
)

# Starlark's serialization framework, for paging frozen heaps out.
crate.spec(
    package = "pagable",
    version = "0.4",
)

crate.annotation(
    crate = "pagable",
    patch_args = ["-p1"],
    patches = ["//third_party/pagable:pagable.patch"],
)

# `pagable`: frozen heaps can be serialized, so analysis can be paged out.
crate.spec(
    features = ["pagable"],
    package = "starlark",
    version = "0.14",
)

crate.spec(
    package = "allocative",
    version = "0.3",
)

crate.spec(
    package = "regex",
    version = "1",
)

# Fetching external repositories: HTTP downloads and the archive formats
# Bazel can extract.
crate.spec(
    package = "ureq",
    version = "2.12",
)

crate.spec(
    default_features = False,
    features = ["deflate"],
    package = "zip",
    version = "2",
)

crate.spec(
    features = ["static"],
    package = "xz2",
    version = "0.1",
)

crate.spec(
    package = "bzip2",
    version = "0.4",
)

# Heap profiling, in a separate build of bb (//buildbox/cli:buildbox_dhat).
crate.spec(
    package = "dhat",
    version = "0.3",
)

# Bazel's dialect of Starlark, which starlark-rust doesn't accept as written.
crate.annotation(
    crate = "starlark",
    patch_args = ["-p1"],
    patches = ["//third_party/starlark:starlark.patch"],
)

# Resolved crate versions are pinned in these lockfiles. To update them, run:
#   CARGO_BAZEL_REPIN=1 bazel build //...
crate.from_specs(
    cargo_lockfile = "//third_party/crates:Cargo.lock",
    lockfile = "//third_party/crates:cargo-bazel-lock.json",
)

use_repo(crate, "crates")
