# Our changes to starlark-rust, as a series of patches with one per commit,
# applied on top of the upstream commit in UPSTREAM.
#
# Don't edit the patches by hand. To change them:
#
#   bazel/patches/patches.sh checkout third_party/starlark <checkout>
#   # ...commit, amend or rebase in <checkout>...
#   bazel/patches/patches.sh export third_party/starlark <checkout>
#
# The checkout is an ordinary clone of starlark-rust with our commits on
# its `buildbox` branch; export regenerates patches/ and patches.MODULE.bazel
# from them.
exports_files(glob(["patches/*/*.patch"]))
