# Patches to starlark-rust:
#
# - A reflected `|` (`rbit_or`), so `dict | select(...)` reaches select.
# - `dict.get` takes `default` by name, as `d.get(key, default = None)`.
# - A top-level def releases its unfrozen bytecode and IR once frozen.
# - `DeserTypeId` holds `type_name::<T>` as a function, so the `pagable`
#   feature builds on stable Rust, which can't call `type_name` in a const.
exports_files(["starlark.patch"])
