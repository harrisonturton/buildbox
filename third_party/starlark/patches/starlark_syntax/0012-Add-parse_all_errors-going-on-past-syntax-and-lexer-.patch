 impl AstModule {
     fn create(
         codemap: CodeMap,
@@ -155,6 +164,19 @@ impl AstModule {
     /// assert_eq!(span.to_string(), "filename:2:11");
     /// ```
     pub fn parse(filename: &str, content: String, dialect: &Dialect) -> crate::Result<Self> {
+        Self::parse_all_errors(filename, content, dialect)
+            .map_err(|errors| errors.into_iter().next().expect("a failure has an error"))
+    }
+
+    /// Like [`parse`](Self::parse), but failing with every error found, in
+    /// the order they appear, rather than only the first: after a syntax
+    /// error, parsing goes on from the next statement at the file's top
+    /// level, and lexing goes on after a lexer error.
+    pub fn parse_all_errors(
+        filename: &str,
+        content: String,
+        dialect: &Dialect,
+    ) -> Result<Self, Vec<crate::Error>> {
         let typecheck = content.contains("@starlark-rust: typecheck");
         let codemap = CodeMap::new(filename.to_owned(), content);
         let lexer = Lexer::new(codemap.source(), dialect, codemap.dupe());
@@ -187,22 +209,24 @@ impl AstModule {
             errors: &mut errors,
         };
 
-        match parser_rd::parse_module(&mut state, filtered) {
-            Ok(v) => {
-                if let Some(err) = errors.into_iter().next() {
-                    return Err(err.into_error());
-                }
-                Ok(AstModule::create(
-                    codemap,
-                    v,
-                    dialect,
-                    typecheck,
-                    lint_suppressions_builder.build(),
-                    comment_spans,
-                )?)
+        let parsed = parser_rd::parse_module(&mut state, filtered);
+        let statement = match parsed {
+            Ok(statement) if errors.is_empty() => statement,
+            Ok(_) => return Err(in_order(errors)),
+            Err(error) => {
+                errors.push(error);
+                return Err(in_order(errors));
             }
-            Err(e) => Err(e.into_error()),
-        }
+        };
+        AstModule::create(
+            codemap,
+            statement,
+            dialect,
+            typecheck,
+            lint_suppressions_builder.build(),
+            comment_spans,
+        )
+        .map_err(|error| vec![error])
     }
 
     /// Return the file names of all the `load` statements in the module.
