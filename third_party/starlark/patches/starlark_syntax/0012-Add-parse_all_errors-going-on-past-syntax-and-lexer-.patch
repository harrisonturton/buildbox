+    /// Skip to the end of the top-level statement a syntax error is in,
+    /// with the indented block it opens if its line ends with `:`, to go on
+    /// parsing after it.
+    fn skip_statement(&mut self) {
+        let mut opens_block = false;
+        while let Some(token) = self.peek() {
+            let ends_line = matches!(token, Token::Newline | Token::Dedent);
+            if !ends_line {
+                opens_block = matches!(token, Token::Colon);
+            }
+            self.advance();
+            if !ends_line || self.depth > 0 {
+                continue;
+            }
+            match self.peek() {
+                Some(Token::Dedent) => {}
+                Some(Token::Indent) if opens_block => {}
+                _ => {
+                    self.depth = 0;
+                    return;
+                }
+            }
         }
     }
 
