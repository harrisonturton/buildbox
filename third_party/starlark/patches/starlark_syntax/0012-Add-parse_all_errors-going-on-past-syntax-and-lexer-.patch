+/// Errors as `crate::Error`s, in the order of where they are.
+fn in_order(errors: Vec<EvalException>) -> Vec<crate::Error> {
+    let mut errors: Vec<crate::Error> =
+        errors.into_iter().map(EvalException::into_error).collect();
+    errors.sort_by_key(|error| error.span().map(|span| span.span.begin()));
+    errors
+}
