From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Harry Turton <harrisonturton@gmail.com>
Date: Sun, 25 Oct 2026 17:13:18 -0400
Subject: [PATCH] Add forget_serialized_heaps, and keep a read-back heap's id

The serializer's map of heaps' addresses outlived the serialization it was
made for, so a heap read back, with its old id at new addresses, counted
as registered, and could be found at addresses since reused. Callers now
forget it before serializing again. A heap read back has no name, so it
keeps the id it was serialized under to be serialized again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/pagable.rs                            |  1 +
 src/pagable/starlark_serialize_context.rs | 19 +++++++++++++--
 src/values/layout/heap/heap_type.rs       | 29 +++++++++++++++++++----
 3 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/src/pagable.rs b/src/pagable.rs
index 6888eaae..640751c4 100644
--- a/src/pagable.rs
+++ b/src/pagable.rs
@@ -78,6 +78,7 @@ pub use starlark_pagable_impls::SmallMapKeyDeserialize;
 pub use starlark_serialize::StarlarkSerialize;
 pub use starlark_serialize::StarlarkSerializeContext;
 pub use starlark_serialize_context::StarlarkSerializerImpl;
+pub use starlark_serialize_context::forget_serialized_heaps;
 
 /// Sealed marker emitted by `#[starlark_pagable_typetag]` on a trait. The
 /// impl form requires it, pairing the two structurally.
diff --git a/src/pagable/starlark_serialize_context.rs b/src/pagable/starlark_serialize_context.rs
index 5e9adadb..0db7883b 100644
--- a/src/pagable/starlark_serialize_context.rs
+++ b/src/pagable/starlark_serialize_context.rs
@@ -67,6 +67,12 @@ impl StarlarkSerState {
         self.registered_heaps.insert(heap_id);
     }
 
+    /// Forget every heap registered so far.
+    fn clear(&self) {
+        self.registered_heaps.clear();
+        self.ptr_to_location.clear();
+    }
+
     /// Check if a heap's offset map has already been registered.
     fn has_heap(&self, heap_id: HeapRefId) -> bool {
         self.registered_heaps.contains(&heap_id)
@@ -100,16 +106,25 @@ impl StarlarkSerState {
     /// pagable arc mechanism defers heap serialization but we need the
     /// value-index maps immediately to resolve pointers.
     pub(crate) fn ensure_offset_maps_registered(&self, heap_ref: &FrozenHeapRef) {
-        let Some(name) = heap_ref.name() else {
+        let Some(heap_id) = heap_ref.ref_id() else {
             return;
         };
-        let heap_id = HeapRefId::from_heap_name(name);
         self.ensure_offset_maps_registered_inner(heap_id, heap_ref.refs_slice(), || {
             heap_ref.build_ptr_to_value_index_map()
         });
     }
 }
 
+/// Forget the addresses of the heaps serialized in `session` so far, before
+/// serializing again once some of them may have been freed: a heap read back
+/// has the same name, and so the same id, at new addresses, and a freed
+/// heap's addresses can be reused by another.
+pub fn forget_serialized_heaps(session: &pagable::SessionContext) {
+    if let Some(state) = session.get::<Arc<StarlarkSerState>>() {
+        state.clear();
+    }
+}
+
 /// Concrete implementation of StarlarkSerializeContext.
 ///
 /// Wraps a `PagableSerializer` and a shared `StarlarkSerState` to
diff --git a/src/values/layout/heap/heap_type.rs b/src/values/layout/heap/heap_type.rs
index 0f448613..983313e5 100644
--- a/src/values/layout/heap/heap_type.rs
+++ b/src/values/layout/heap/heap_type.rs
@@ -366,6 +366,9 @@ struct FrozenFrozenHeap {
     // TODO(nero): remove Option here, make it required.
     #[allocative(skip)] // We don't really expect it to be big
     name: Option<FrozenHeapName>,
+    /// The id a deserialized heap, which has no name, was serialized under.
+    #[allocative(skip)]
+    serialized_id: Option<HeapRefId>,
     peak_allocated_bytes: Option<usize>,
 }
 
@@ -402,6 +405,15 @@ impl PartiallyDeserializedHeap {
 }
 
 impl FrozenFrozenHeap {
+    /// The id this heap is serialized under: its name's, or, if it was
+    /// deserialized, the id it was serialized under before.
+    fn ref_id(&self) -> Option<HeapRefId> {
+        match &self.name {
+            Some(name) => Some(HeapRefId::from_heap_name(name)),
+            None => self.serialized_id,
+        }
+    }
+
     /// Serialization format:
     /// ```text
     /// [refs_count: usize]
@@ -430,11 +442,9 @@ impl FrozenFrozenHeap {
     ///   [value_data...]
     /// ```
     fn serialize_inner(&self, serializer: &mut dyn PagableSerializer) -> crate::Result<()> {
-        let heap_name = self
-            .name
-            .as_ref()
+        let heap_id = self
+            .ref_id()
             .expect("The name of the FrozenFrozenHeap should exist in starlark pagable serialize");
-        let heap_id = HeapRefId::from_heap_name(heap_name);
         // TODO(nero): right now FrozenHeapName hasn't been implemented for Pagable. so just serialize HeapRefId;
         heap_id.pagable_serialize(serializer)?;
 
@@ -557,7 +567,8 @@ impl FrozenFrozenHeap {
         // Register per-value header addresses in shared state.
         state.register_heap(heap_id, value_addrs);
 
-        let heap = Self::deserialize_phase2(arena, refs, &mut ctx)?;
+        let mut heap = Self::deserialize_phase2(arena, refs, &mut ctx)?;
+        heap.serialized_id = Some(heap_id);
 
         Ok(heap)
     }
@@ -702,6 +713,7 @@ impl FrozenFrozenHeap {
             arena,
             refs: refs.into_boxed_slice(),
             name: None,
+            serialized_id: None,
             peak_allocated_bytes: None,
         })
     }
@@ -868,6 +880,12 @@ impl FrozenHeapRef {
         self.0.as_ref().and_then(|a| a.name.as_ref())
     }
 
+    /// The id this heap is serialized under, which a deserialized heap
+    /// keeps although it has no name.
+    pub(crate) fn ref_id(&self) -> Option<HeapRefId> {
+        self.0.as_ref().and_then(|a| a.ref_id())
+    }
+
     /// Get the frozen heaps that this frozen heap depends on.
     pub fn refs(&self) -> impl Iterator<Item = &FrozenHeapRef> {
         self.0.as_ref().map(|h| h.refs.iter()).into_iter().flatten()
@@ -994,6 +1012,7 @@ impl FrozenHeap {
                 arena,
                 refs: refs.into_iter().collect(),
                 name,
+                serialized_id: None,
                 peak_allocated_bytes,
             })))
         }
