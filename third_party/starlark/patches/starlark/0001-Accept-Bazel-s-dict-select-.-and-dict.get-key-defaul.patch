From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Harry Turton <harrisonturton@gmail.com>
Date: Sat, 24 Oct 2026 08:40:13 -0400
Subject: [PATCH] Accept Bazel's dict | select(...) and dict.get(key, default =
 ...)

Add a reflected `|`, StarlarkValue::rbit_or, tried when the left operand
doesn't support the right, so a value such as Bazel's select can
implement `dict | select(...)`, and `|=` with one. dict.get takes
`default` by name, as Bazel allows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/eval/compiler/stmt.rs        | 7 ++++++-
 src/values/layout/value.rs       | 5 ++++-
 src/values/layout/vtable.rs      | 5 +++++
 src/values/traits.rs             | 7 +++++++
 src/values/types/dict/methods.rs | 2 +-
 5 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/src/eval/compiler/stmt.rs b/src/eval/compiler/stmt.rs
index c6c7b651..18211d7a 100644
--- a/src/eval/compiler/stmt.rs
+++ b/src/eval/compiler/stmt.rs
@@ -576,6 +576,11 @@ pub(crate) fn bit_or_assign<'v>(
         if lhs.ptr_eq(rhs) {
             // Nothing to do as union is idempotent
         } else {
+            if DictRef::from_value(rhs).is_none() {
+                if let Some(result) = rhs.get_ref().rbit_or(lhs, heap) {
+                    return result;
+                }
+            }
             let rhs = DictRef::from_value(rhs).map_or_else(
                 || {
                     ValueError::unsupported_owned(
@@ -592,7 +597,7 @@ pub(crate) fn bit_or_assign<'v>(
         }
         Ok(lhs)
     } else {
-        lhs_aref.bit_or(rhs, heap)
+        lhs.bit_or(rhs, heap)
     }
 }
 
diff --git a/src/values/layout/value.rs b/src/values/layout/value.rs
index 7554138a..0d71174a 100644
--- a/src/values/layout/value.rs
+++ b/src/values/layout/value.rs
@@ -644,7 +644,10 @@ impl<'v> Value<'v> {
 
     /// `x | other`.
     pub fn bit_or(self, other: Value<'v>, heap: Heap<'v>) -> crate::Result<Value<'v>> {
-        self.get_ref().bit_or(other, heap)
+        match self.get_ref().bit_or(other, heap) {
+            Ok(value) => Ok(value),
+            Err(error) => other.get_ref().rbit_or(self, heap).unwrap_or(Err(error)),
+        }
     }
 
     /// `x ^ other`.
diff --git a/src/values/layout/vtable.rs b/src/values/layout/vtable.rs
index bd931eed..519d4ae5 100644
--- a/src/values/layout/vtable.rs
+++ b/src/values/layout/vtable.rs
@@ -577,6 +577,11 @@ impl<'v> AValueDyn<'v> {
         (self.vtable.starlark_value.radd)(self.value, other, heap)
     }
 
+    #[inline]
+    pub(crate) fn rbit_or(self, other: Value<'v>, heap: Heap<'v>) -> Option<crate::Result<Value<'v>>> {
+        (self.vtable.starlark_value.rbit_or)(self.value, other, heap)
+    }
+
     #[inline]
     pub(crate) fn sub(self, other: Value<'v>, heap: Heap<'v>) -> crate::Result<Value<'v>> {
         (self.vtable.starlark_value.sub)(self.value, other, heap)
diff --git a/src/values/traits.rs b/src/values/traits.rs
index 33883661..f72ed018 100644
--- a/src/values/traits.rs
+++ b/src/values/traits.rs
@@ -832,6 +832,13 @@ pub trait StarlarkValue<'v>:
         ValueError::unsupported_with(self, "|", other)
     }
 
+    /// `|` with the arguments the other way around, for when the left
+    /// operand doesn't support the right, as with `dict | select(...)` in
+    /// Bazel. Return [`None`] to keep the left operand's error.
+    fn rbit_or(&self, _lhs: Value<'v>, _heap: Heap<'v>) -> Option<crate::Result<Value<'v>>> {
+        None
+    }
+
     /// Bitwise `^` operator.
     fn bit_xor(&self, other: Value<'v>, _heap: Heap<'v>) -> crate::Result<Value<'v>> {
         ValueError::unsupported_with(self, "^", other)
diff --git a/src/values/types/dict/methods.rs b/src/values/types/dict/methods.rs
index e71c19f8..43bff82a 100644
--- a/src/values/types/dict/methods.rs
+++ b/src/values/types/dict/methods.rs
@@ -83,7 +83,7 @@ pub(crate) fn dict_methods(registry: &mut MethodsBuilder) {
     fn get<'v>(
         this: DictRef<'v>,
         #[starlark(require = pos)] key: Value<'v>,
-        #[starlark(require = pos)] default: Option<Value<'v>>,
+        default: Option<Value<'v>>,
     ) -> starlark::Result<Value<'v>> {
         match this.get(key)? {
             None => Ok(default.unwrap_or_else(Value::new_none)),
