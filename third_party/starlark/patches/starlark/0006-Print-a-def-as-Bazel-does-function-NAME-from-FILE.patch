From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Harry Turton <harrisonturton@gmail.com>
Date: Sun, 25 Oct 2026 15:57:56 -0400
Subject: [PATCH] Print a def as Bazel does: <function NAME from FILE>

starlark-rust printed a def's signature. Bazel's with_cfg.bzl tells
rules, macros and functions apart by how they print.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/eval/compiler/def.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/eval/compiler/def.rs b/src/eval/compiler/def.rs
index 7d940e11..a46c921a 100644
--- a/src/eval/compiler/def.rs
+++ b/src/eval/compiler/def.rs
@@ -666,9 +666,15 @@ fn deserialize_optimized_on_freeze_stmt(
     })
 }
 
+/// As Bazel shows a function: `<function NAME from FILE>`.
 impl<V> Display for DefGen<V> {
     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
-        write!(f, "{}", self.parameters.signature())
+        write!(
+            f,
+            "<function {} from {}>",
+            self.def_info.name.as_str(),
+            self.def_info.codemap.filename()
+        )
     }
 }
 
