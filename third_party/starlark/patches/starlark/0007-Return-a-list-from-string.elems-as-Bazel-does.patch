From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Harry Turton <harrisonturton@gmail.com>
Date: Sun, 25 Oct 2026 15:57:56 -0400
Subject: [PATCH] Return a list from string.elems(), as Bazel does

starlark-rust returns an iterator, which can't be indexed or sliced;
rules_python's requirements parser slices it (`content.elems()[:]`).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/values/types/string/methods.rs | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/src/values/types/string/methods.rs b/src/values/types/string/methods.rs
index 86f1371b..b1d1b719 100644
--- a/src/values/types/string/methods.rs
+++ b/src/values/types/string/methods.rs
@@ -39,7 +39,6 @@ use crate::values::none::NoneOr;
 use crate::values::string::dot_format;
 use crate::values::tuple::UnpackTuple;
 use crate::values::type_repr::StarlarkTypeRepr;
-use crate::values::types::string::iter::iterate_chars;
 use crate::values::types::string::iter::iterate_codepoints;
 use crate::values::typing::iter::StarlarkIter;
 
@@ -113,19 +112,15 @@ pub(crate) fn string_methods(builder: &mut MethodsBuilder) {
     /// `S.elems()` returns an iterable value containing the
     /// sequence of numeric bytes values in the string S.
     ///
-    /// To materialize the entire sequence of bytes, apply `list(...)` to the
-    /// result.
+    /// As in Bazel, the result is a list, so it can be indexed and sliced.
     ///
     /// ```
     /// # starlark::assert::is_true(r#"
     /// list("Hello, 世界".elems()) == ["H", "e", "l", "l", "o", ",", " ", "世", "界"]
     /// # "#);
     /// ```
-    fn elems<'v>(
-        this: StringValue<'v>,
-        heap: Heap<'v>,
-    ) -> anyhow::Result<ValueOfUnchecked<'v, StarlarkIter<String>>> {
-        Ok(iterate_chars(this, heap))
+    fn elems<'v>(this: &str, heap: Heap<'v>) -> anyhow::Result<Vec<Value<'v>>> {
+        Ok(this.chars().map(|c| heap.alloc(c)).collect())
     }
 
     /// [string.capitalize](
