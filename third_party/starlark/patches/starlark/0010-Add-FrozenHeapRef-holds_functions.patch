From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Harry Turton <harrisonturton@gmail.com>
Date: Sun, 25 Oct 2026 17:13:46 -0400
Subject: [PATCH] Add FrozenHeapRef::holds_functions

A function's compiled code points into the heap it was frozen in and
isn't relocated when its heap is read back, so callers need to know which
heaps can't be paged out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/values/layout/heap/heap_type.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/values/layout/heap/heap_type.rs b/src/values/layout/heap/heap_type.rs
index 983313e5..a2e41c57 100644
--- a/src/values/layout/heap/heap_type.rs
+++ b/src/values/layout/heap/heap_type.rs
@@ -886,6 +886,20 @@ impl FrozenHeapRef {
         self.0.as_ref().and_then(|a| a.ref_id())
     }
 
+    /// Whether this heap holds functions. A function's compiled code points
+    /// into the heap it was frozen in, and isn't relocated when the heap is
+    /// serialized and read back, so such a heap can't be paged out.
+    pub fn holds_functions(&self) -> bool {
+        let Some(heap) = self.0.as_ref() else {
+            return false;
+        };
+        let drop = heap.arena.collect_drop_headers_ordered();
+        let non_drop = heap.arena.collect_undrop_headers_ordered();
+        drop.iter()
+            .chain(non_drop.iter())
+            .any(|header| header.unpack().vtable().type_name == crate::values::function::FUNCTION_TYPE)
+    }
+
     /// Get the frozen heaps that this frozen heap depends on.
     pub fn refs(&self) -> impl Iterator<Item = &FrozenHeapRef> {
         self.0.as_ref().map(|h| h.refs.iter()).into_iter().flatten()
