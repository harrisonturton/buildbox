load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:version.bzl", "VERSION")

rust_binary(
    name = "buildbox",
    srcs = [
        "actions.rs",
        "artifacts.rs",
        "bazel.rs",
        "blobs.rs",
        "client.rs",
        "config_args.rs",
        "format.rs",
        "image_layout.rs",
        "main.rs",
        "status.rs",
        "up.rs",
    ],
    version = VERSION,
    visibility = ["//buildbox:__pkg__"],
    deps = [
        "//buildbox/admin:admin_rust_connect",
        "//buildbox/bazel/server",
        "//buildbox/bazel/server:bazel_rust_connect",
        "//buildbox/cas",
        "//buildbox/config",
        "//buildbox/jemalloc",
        "//buildbox/container:namespaces",
        "//buildbox/oci",
        "//buildbox/server",
        "//buildbox/telemetry",
        "//third_party/googleapis:bytestream_rust_connect",
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:clap",
        "@crates//:connectrpc",
        "@crates//:flate2",
        "@crates//:http",
        "@crates//:libc",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

# bb with a heap profiler: `bb up` writes dhat-heap.json, recording every
# allocation still live and where it was made, when it shuts down.
rust_binary(
    name = "buildbox_dhat",
    srcs = [
        "actions.rs",
        "artifacts.rs",
        "bazel.rs",
        "blobs.rs",
        "client.rs",
        "config_args.rs",
        "format.rs",
        "image_layout.rs",
        "main.rs",
        "status.rs",
        "up.rs",
    ],
    crate_features = ["dhat-heap"],
    crate_name = "buildbox",
    version = VERSION,
    deps = [
        "//buildbox/admin:admin_rust_connect",
        "//buildbox/bazel/server",
        "//buildbox/bazel/server:bazel_rust_connect",
        "//buildbox/cas",
        "//buildbox/config",
        "//buildbox/container:namespaces",
        "//buildbox/oci",
        "//buildbox/server",
        "//buildbox/telemetry",
        "//third_party/googleapis:bytestream_rust_connect",
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:clap",
        "@crates//:connectrpc",
        "@crates//:dhat",
        "@crates//:flate2",
        "@crates//:http",
        "@crates//:libc",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "buildbox_test",
    crate = ":buildbox",
    deps = ["@crates//:serde_json"],
)
