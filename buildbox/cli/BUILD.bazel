load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "buildbox",
    srcs = [
        "config_args.rs",
        "main.rs",
        "show_config.rs",
        "up.rs",
    ],
    visibility = ["//buildbox:__pkg__"],
    deps = [
        "//buildbox/config",
        "//buildbox/server",
        "@crates//:clap",
        "@crates//:tokio",
        "@crates//:toml",
        "@crates//:tracing-subscriber",
    ],
)

rust_test(
    name = "buildbox_test",
    crate = ":buildbox",
)
