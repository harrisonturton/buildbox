load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:version.bzl", "VERSION")

rust_binary(
    name = "buildbox",
    srcs = [
        "actions.rs",
        "artifacts.rs",
        "blobs.rs",
        "client.rs",
        "config_args.rs",
        "format.rs",
        "image_layout.rs",
        "main.rs",
        "show_config.rs",
        "status.rs",
        "up.rs",
    ],
    version = VERSION,
    visibility = ["//buildbox:__pkg__"],
    deps = [
        "//buildbox/admin:admin_rust_connect",
        "//buildbox/cas",
        "//buildbox/config",
        "//buildbox/container:namespaces",
        "//buildbox/oci",
        "//buildbox/server",
        "//buildbox/telemetry",
        "//third_party/googleapis:bytestream_rust_connect",
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:clap",
        "@crates//:connectrpc",
        "@crates//:flate2",
        "@crates//:http",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "buildbox_test",
    crate = ":buildbox",
    deps = ["@crates//:serde_json"],
)
