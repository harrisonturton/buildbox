load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "cas",
    srcs = [
        "cas.rs",
        "digest.rs",
    ],
    crate_root = "cas.rs",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:data-encoding",
        "@crates//:ring",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "cas_test",
    crate = ":cas",
)

rust_library(
    name = "fs",
    srcs = ["fs.rs"],
    crate_name = "cas_fs",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        ":cas",
        "//buildbox/fsutil",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "fs_test",
    crate = ":fs",
    deps = [":conformance"],
)

rust_library(
    name = "mem",
    srcs = ["mem.rs"],
    crate_name = "cas_mem",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        ":cas",
        "@crates//:bytes",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "mem_test",
    crate = ":mem",
    deps = [":conformance"],
)

rust_library(
    name = "conformance",
    testonly = True,
    srcs = ["conformance.rs"],
    crate_name = "cas_conformance",
    deps = [
        ":cas",
        "@crates//:tempfile",
    ],
)
