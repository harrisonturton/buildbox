load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "executor",
    srcs = glob(["**/*.rs"]),
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//buildbox/common",
        "//buildbox/proto",
        "//buildbox/storage",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "tests",
    crate = ":executor",
    deps = ["@crates//:tempdir"],
)