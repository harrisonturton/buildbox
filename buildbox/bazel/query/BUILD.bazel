load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "query",
    srcs = [
        "build_output.rs",
        "engine.rs",
        "functions.rs",
        "graph.rs",
        "lexer.rs",
        "nodes.rs",
        "output.rs",
        "parse.rs",
        "query.rs",
        "target_graph.rs",
        "universe.rs",
        "xml_output.rs",
    ],
    crate_name = "bazel_query",
    crate_root = "query.rs",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//buildbox/bazel/fs",
        "//buildbox/bazel/label",
        "//buildbox/bazel/loading",
        "//buildbox/bazel/packages",
        "//buildbox/intern",
        "//buildbox/skyframe",
        "@crates//:futures",
        "@crates//:regex",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "query_unit_test",
    crate = ":query",
)
