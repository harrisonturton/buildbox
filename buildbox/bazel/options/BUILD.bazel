load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "options",
    srcs = [
        "bazel.rs",
        "jobs.rs",
        "options.rs",
        "rc.rs",
        "tests.rs",
    ],
    compile_data = ["bazel_options.txt"],
    crate_name = "bazel_options",
    crate_root = "options.rs",
    visibility = ["//buildbox:__subpackages__"],
    deps = ["@crates//:thiserror"],
)

rust_test(
    name = "options_test",
    crate = ":options",
)
