load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:version.bzl", "VERSION")
load("//bazel/connect:defs.bzl", "rust_connect_library")

package(default_visibility = ["//visibility:private"])

proto_library(
    name = "bazel_proto",
    srcs = ["bazel.proto"],
)

rust_connect_library(
    name = "bazel_rust_connect",
    protos = [":bazel_proto"],
    visibility = [
        "//buildbox/cli:__pkg__",
        "//buildbox/server:__pkg__",
    ],
)

rust_library(
    name = "server",
    srcs = [
        "build.rs",
        "build_events.rs",
        "build_id.rs",
        "command.rs",
        "commands.rs",
        "fetch.rs",
        "modcmd.rs",
        "help.rs",
        "invocation.rs",
        "memory.rs",
        "output.rs",
        "queries.rs",
        "repos.rs",
        "run.rs",
        "runfiles.rs",
        "running.rs",
        "server.rs",
        "service.rs",
        "test.rs",
        "test_options.rs",
        "top_level.rs",
        "workspace.rs",
        "written.rs",
    ],
    compile_data = [
        "help/aquery.txt",
        "help/build.txt",
        "help/clean.txt",
        "help/cquery.txt",
        "help/dump.txt",
        "help/fetch.txt",
        "help/help.txt",
        "help/info.txt",
        "help/license.txt",
        "help/mod.txt",
        "help/query.txt",
        "help/run.txt",
        "help/shutdown.txt",
        "help/target-syntax.txt",
        "help/test.txt",
        "help/version.txt",
    ],
    crate_name = "bazel_server",
    crate_root = "server.rs",
    version = VERSION,
    visibility = [
        "//buildbox/cli:__pkg__",
        "//buildbox/server:__pkg__",
    ],
    deps = [
        ":bazel_rust_connect",
        "//buildbox/bazel/analysis",
        "//buildbox/bazel/bep",
        "//buildbox/bazel/bzlmod",
        "//buildbox/bazel/config",
        "//buildbox/bazel/execution",
        "//buildbox/bazel/fetch",
        "//buildbox/bazel/fs",
        "//buildbox/bazel/label",
        "//buildbox/bazel/loading",
        "//buildbox/bazel/options",
        "//buildbox/bazel/packages",
        "//buildbox/bazel/progress",
        "//buildbox/bazel/cquery",
        "//buildbox/bazel/query",
        "//buildbox/bazel/starlark",
        "//buildbox/bazel/ui",
        "//buildbox/intern",
        "//buildbox/jemalloc",
        "//buildbox/persist",
        "//buildbox/skycodec",
        "//buildbox/skyframe",
        "@crates//:connectrpc",
        "@crates//:futures",
        "@crates//:regex",
        "@crates//:ring",
        "@crates//:serde_json",
        "@crates//:starlark",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:zip",
    ],
)

rust_test(
    name = "server_test",
    crate = ":server",
    deps = ["@crates//:tempfile"],
)
