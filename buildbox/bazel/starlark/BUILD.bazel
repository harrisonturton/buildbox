load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "starlark",
    srcs = [
        "attr_module.rs",
        "autoload.rs",
        "build_api.rs",
        "bzl_api.rs",
        "context.rs",
        "convert.rs",
        "depset.rs",
        "dotted_version.rs",
        "eval.rs",
        "fields.rs",
        "instantiate.rs",
        "hash.rs",
        "json_module.rs",
        "label_value.rs",
        "native_rules.rs",
        "opaque.rs",
        "package_builder.rs",
        "paging.rs",
        "provider.rs",
        "repo_api.rs",
        "rule_value.rs",
        "select.rs",
        "symbolic_macro.rs",
        "toolchain_type.rs",
        "starlark.rs",
    ],
    crate_name = "bazel_starlark",
    crate_root = "starlark.rs",
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//buildbox/bazel/label",
        "//buildbox/bazel/packages",
        "//buildbox/intern",
        "//buildbox/skycodec",
        "@crates//:allocative",
        "@crates//:anyhow",
        "@crates//:pagable",
        "@crates//:rustc-hash",
        "@crates//:serde_json",
        "@crates//:starlark",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "starlark_unit_test",
    crate = ":starlark",
)

rust_test(
    name = "starlark_test",
    srcs = ["tests.rs"],
    deps = [
        ":starlark",
        "//buildbox/bazel/label",
        "//buildbox/bazel/packages",
        "//buildbox/intern",
        "@crates//:anyhow",
        "@crates//:starlark",
    ],
)
