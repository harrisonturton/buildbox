load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "packages",
    srcs = [
        "attr.rs",
        "error.rs",
        "packages.rs",
        "rule_class.rs",
    ],
    crate_name = "bazel_packages",
    crate_root = "packages.rs",
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//buildbox/bazel/label",
        "//buildbox/intern",
        "//buildbox/skycodec",
    ],
)

rust_test(
    name = "packages_test",
    crate = ":packages",
)
