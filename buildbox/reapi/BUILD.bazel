load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "reapi",
    srcs = [
        "action_cache_service.rs",
        "bytestream_service.rs",
        "cached_result.rs",
        "capabilities_service.rs",
        "cas_service.rs",
        "execution_service.rs",
        "lib.rs",
        "status.rs",
    ],
    visibility = ["//buildbox/server:__pkg__"],
    deps = [
        "//buildbox/actioncache",
        "//buildbox/cas",
        "//buildbox/executor",
        "//third_party/googleapis:any_rust_proto",
        "//third_party/googleapis:bytestream_rust_proto",
        "//third_party/googleapis:operations_rust_proto",
        "//third_party/googleapis:status_rust_proto",
        "//third_party/remoteapis:remote_execution_rust_proto",
        "//third_party/remoteapis:semver_rust_proto",
        "@crates//:prost",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "reapi_test",
    crate = ":reapi",
    deps = [
        "//buildbox/actioncache:mem",
        "//buildbox/cas:mem",
    ],
)
