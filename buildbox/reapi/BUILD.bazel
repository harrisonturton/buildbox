load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "reapi",
    srcs = [
        "action_cache_service.rs",
        "bytestream_service.rs",
        "cached_result.rs",
        "capabilities_service.rs",
        "cas_service.rs",
        "execution_service.rs",
        "invocations.rs",
        "lib.rs",
        "request_tracing.rs",
        "status.rs",
    ],
    visibility = ["//buildbox/server:__pkg__"],
    deps = [
        "//buildbox/actioncache",
        "//buildbox/cas",
        "//buildbox/executor",
        "//buildbox/telemetry",
        "//third_party/googleapis:bytestream_rust_connect",
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:buffa",
        "@crates//:buffa-types",
        "@crates//:connectrpc",
        "@crates//:data-encoding",
        "@crates//:http",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "reapi_test",
    crate = ":reapi",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//buildbox/actioncache:mem",
        "//buildbox/cas:mem",
        "@crates//:tracing-subscriber",
    ],
)
