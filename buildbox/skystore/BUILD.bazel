load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "skystore",
    srcs = [
        "checkpoint.rs",
        "compress.rs",
        "dictionaries.rs",
        "mmap.rs",
        "pages.rs",
        "segments.rs",
        "skystore.rs",
        "tests.rs",
    ],
    crate_root = "skystore.rs",
    visibility = ["//buildbox:__subpackages__"],
    deps = [
        "//buildbox/skycodec",
        "@crates//:hashbrown",
        "@crates//:libc",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:zstd",
    ],
)

rust_test(
    name = "skystore_test",
    crate = ":skystore",
    deps = ["@crates//:tempfile"],
)
