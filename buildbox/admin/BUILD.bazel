load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:version.bzl", "VERSION")
load("//bazel/connect:defs.bzl", "rust_connect_library")

proto_library(
    name = "admin_proto",
    srcs = ["admin.proto"],
)

rust_connect_library(
    name = "admin_rust_connect",
    protos = [":admin_proto"],
    visibility = [
        "//buildbox/cli:__pkg__",
        "//buildbox/server:__pkg__",
    ],
)

rust_library(
    name = "admin",
    srcs = ["admin_service.rs"],
    version = VERSION,
    visibility = ["//buildbox/server:__pkg__"],
    deps = [
        ":admin_rust_connect",
        "//buildbox/actioncache",
        "//buildbox/artifacts",
        "//buildbox/cas",
        "//buildbox/scheduler",
        "@crates//:connectrpc",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "admin_test",
    crate = ":admin",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//buildbox/actioncache:mem",
        "//buildbox/cas:mem",
        "//buildbox/executor",
        "//third_party/remoteapis:remote_execution_rust_connect",
        "@crates//:tokio",
    ],
)
