load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

proto_library(
    name = "admin_proto",
    srcs = ["admin.proto"],
)

rust_prost_library(
    name = "admin_rust_proto",
    proto = ":admin_proto",
    visibility = [
        "//buildbox/cli:__pkg__",
        "//buildbox/server:__pkg__",
    ],
)

rust_library(
    name = "admin",
    srcs = ["admin_service.rs"],
    visibility = ["//buildbox/server:__pkg__"],
    deps = [
        ":admin_rust_proto",
        "@crates//:tonic",
    ],
)
