"""Build server"""

module(name = "build-server")

# Dependencies from the local registry

bazel_dep(name = "google_apis_bep", version = "0.0.1")
bazel_dep(name = "google_apis_bes", version = "0.0.1")
bazel_dep(name = "google_apis_core", version = "0.0.1")
bazel_dep(name = "google_apis_proto", version = "0.0.1")
bazel_dep(name = "google_apis_rbe", version = "0.0.1")

# Dependencies from the Bazel Central registry

bazel_dep(name = "apple_support", version = "1.24.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_prost", version = "0.74.0")
bazel_dep(name = "toolchains_protoc", version = "0.6.1")
bazel_dep(name = "toolchains_llvm", version = "1.11.2")

# Hermetic C/C++ toolchain, used by rules_rust for linking. Avoids depending on
# whatever compiler (if any) is installed on the host.

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

llvm.toolchain(
    llvm_version = "20.1.4",
)

# Link against a pinned Debian sysroot rather than the host's libc and libgcc,
# so builds don't depend on which -dev packages the host has installed. This is
# Chromium's published sysroot; the hash is from Chromium's
# build/linux/sysroot_scripts/sysroots.json.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sysroot_linux_x86_64",
    build_file_content = """
filegroup(
    name = "sysroot",
    srcs = glob(
        [
            "lib/**",
            "lib64/**",
            "usr/include/**",
            "usr/lib/**",
        ],
        # Unit files have names that aren't valid Bazel labels, and aren't
        # needed for compiling or linking.
        exclude = [
            "lib/systemd/**",
            "usr/lib/systemd/**",
        ],
    ),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e"],
    type = "tar.xz",
)

llvm.sysroot(
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)

use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")

# Rust toolchain

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

rust.toolchain(
    edition = "2021",
    versions = ["1.98.0"],
)

use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Rust analyzer

rust_analyzer_dependencies = use_repo_rule("@rules_rust//tools/rust_analyzer:deps.bzl", "rust_analyzer_dependencies")
rust_analyzer_dependencies(name = "deps")

# Rust crates

register_toolchains("//tools/bazel/toolchains/prost:prost_toolchain")

crate = use_extension(
    "@rules_rust//crate_universe:extension.bzl",
    "crate",
    isolate = True,
)

crate.spec(
    package = "clap",
    version = "4.5",
    features = ["derive"],
)

crate.spec(
    package = "bytes",
    version = "1.7",
)

crate.spec(
    package = "tracing",
    version = "0.1",
)

crate.spec(
    package = "tracing-subscriber",
    version = "0.3",
    features = ["env-filter"],
)

crate.spec(
    package = "thiserror",
    version = "1.0",
)

crate.spec(
    package = "ring",
    version = "0.17",
)

crate.spec(
    package = "base64",
    version = "0.22",
)

crate.spec(
    package = "async-trait",
    version = "0.1",
)

crate.spec(
    package = "serde",
    version = "1.0",
    features = ["derive"],
)

crate.spec(
    package = "toml",
    version = "0.8",
)

crate.spec(
    package = "rand",
    version = "0.9",
)

crate.spec(
    package = "data-encoding",
    version = "2.8",
)

crate.spec(
    package = "shellexpand",
    version = "3.1",
)

# Rust gRPC and proto dependencies

crate.spec(
    package = "tokio",
    version = "1",
    features = ["full"],
)

crate.spec(
    package = "tokio-stream",
    version = "0.1",
    features = ["full"],
)

crate.spec(
    package = "prost",
    version = "0.13",
)

crate.spec(
    default_features = False,
    package = "prost-types",
    version = "0.13",
)

crate.spec(
    package = "tonic",
    features = ["transport", "tls"],
    version = "0.12",
)

crate.spec(
    package = "protoc-gen-prost",
    version = "0.4",
)

crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)

crate.spec(
    package = "protoc-gen-tonic",
    version = "0.4",
)

crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)

# Resolved crate versions are pinned in these lockfiles. To update them, run:
#   CARGO_BAZEL_REPIN=1 bazel build //...
crate.from_specs(
    cargo_lockfile = "//third_party/crates:Cargo.lock",
    generate_binaries = True,
    lockfile = "//third_party/crates:cargo-bazel-lock.json",
)

use_repo(crate, "crates")
